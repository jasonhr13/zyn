# macOS and editor metadata
.DS_Store
*.swp
*.swo
*.tmp
*.log

# Local configuration and credentials
.env
.env.*
!.env.example
/.local/

# JavaScript dependencies and generated frontend output
frontend/node_modules/
frontend/build/
launcher/node_modules/
release-tools/

# Packaged applications, installers, downloaded runtimes, and staging output
/dist/
/staging/
/vendor/
/archive/
/Hope-Setup*.exe
/updates/*/
/.wrangler/
/release/dist/
/release/work/
/release/runtime-artifacts/
/release/runtime-staging/

# Chrome creates this cache when an unpacked extension is loaded locally.
/chrome-extension/harvester/_metadata/

# Recovered installer/application working trees contain bundled binaries,
# third-party dependencies, and embedded production credentials. R0 will
# import the required main-process sources into a clean, sanitized source tree.
/extracted/

# Secrets — set via `fly secrets set ...` in production, or a local .env for dev.

# ISP proxies, comma- or newline-separated. Empty = direct connection.
PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port

# Sinks (both optional). Omit to only log + store events.
WEBHOOK_URL=https://myapp.example.com/hooks/restock
WEBHOOK_HMAC_SECRET=
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Admin token guards /events (health stays open). Empty = no auth.
ADMIN_TOKEN=

# --- Tunables (all have defaults) ---
# DISCOVERY_KEYWORDS=pokemon,pokemon elite trainer,pokemon booster bundle
# DISCOVERY_INTERVAL_S=300
# HOT_INTERVAL_S=3
# WARM_INTERVAL_S=30
# WARM_AFTER_MIN=60
# BATCH_SIZE=25
# MAX_RPM=600
# STORE_ID=875
# ZIP=20002
# REDSKY_KEY=9f36aeafbe60771e321a7cc95a78140772ab3e96

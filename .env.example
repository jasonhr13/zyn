# Local development. The Go process does not load this file automatically;
# export these variables in your shell or use your preferred env-file runner.
POLAR_DEV_MODE=true
POLAR_FRONTEND_PORT=8000
POLAR_BACKEND_USERNAME=local-developer

# Target's anti-bot header sidecar. Required only when running Target checkout.
POLAR_TARGET_SHAPE_URL=ws://127.0.0.1:4312/ws

# Production/cloud operation. Not required with POLAR_DEV_MODE=true.
POLAR_BACKEND_KEY=
POLAR_CLOUD_URL=wss://polar-wss-production.up.railway.app

# Optional telemetry and panic/security alerts. Empty values disable them.
POLAR_DATADOG_TOKEN=
POLAR_DATADOG_SITE=us5.datadoghq.com
POLAR_ALERT_WEBHOOK_URL=
POLAR_SECURITY_WEBHOOK_URL=

{
  "name": "hope-updates",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "updates.rcart.app",
      "custom_domain": true
    },
    {
      "pattern": "updates.zynbot.app",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "hope-releases"
    }
  ],
  "secrets": {
    "required": [
      "ZYN_EXTENSION_RELEASE_DISCORD_WEBHOOK",
      "ZYN_APP_RELEASE_DISCORD_WEBHOOK"
    ]
  }
}
